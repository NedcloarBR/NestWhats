		"reflect-metadata": "0.2.2",
		"release-it": "19.2.4",
		"rimraf": "6.1.3",
		"rxjs": "7.8.2",
		"ts-node": "10.9.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.2.0 || ^11.0.0",
