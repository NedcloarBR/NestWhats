		"release-it": "release-it",
		"format": "biome format --write ./src",
		"lint": "biome lint ./src",
		"check": "biome check --write ./src"
	},
	"devDependencies": {
		"@nestjs/common": "11.1.23",
		"@nestjs/core": "11.1.23",
		"@types/node": "22.19.19",
