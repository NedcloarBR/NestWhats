		"ts-node": "10.9.2",
		"whatsapp-web.js": "^1.34.7"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.2.0 || ^11.0.0",
		"@nestjs/core": "^10.2.0 || ^11.0.0",
		"class-transformer": ">=0.5.0",
		"class-validator": ">=0.14.0",
		"reflect-metadata": "^0.2.1",
		"rxjs": "^7.2.0",
		"whatsapp-web.js": "^1.34.0"
	},
	"peerDependenciesMeta": {
