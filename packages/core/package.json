{
	"name": "nestwhats",
	"description": "A whatsapp-web.js wrapper for NestJS to create WhatsApp bots",
	"version": "3.0.0",
	"author": {
		"name": "Miguel Alexandre Uhlein",
		"email": "nedcloar1@hotmail.com"
	},
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NedcloarBR/NestWhats.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/NedcloarBR/NestWhats/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "README.md", "License"],
	"keywords": [
		"nest",
		"nestjs",
		"nestjs-module",
		"whatsapp",
		"whatsapp-web-js",
		"whatsapp bot",
		"bot",
		"bot api",
		"bot framework"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"changelog": "git cliff --prepend ./CHANGELOG.md --latest -c ../../cliff.toml -r ../..",
		"release-it": "release-it",
		"format": "biome format --write ./src",
		"lint": "biome lint ./src",
		"check": "biome check --write ./src"
	},
	"dependencies": {
		"path-to-regexp": "8.4.2",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@nestjs/common": "11.1.23",
		"@nestjs/core": "11.1.23",
		"@types/node": "22.19.19",
