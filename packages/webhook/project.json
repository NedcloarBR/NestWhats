{
	"name": "webhook",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/webhook/src",
	"projectType": "library",
	"tags": ["scope:webhook", "type:library"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"dependsOn": ["^build"],
			"options": {
				"command": "rimraf dist && tsc -p tsconfig.build.json",
				"cwd": "{projectRoot}"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p tsconfig.build.json --noEmit",
				"cwd": "{projectRoot}"
			}
		}
	}
}
