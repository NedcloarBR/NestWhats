{
	"name": "@nestwhats/locale",
	"description": "Locale resolution for nestwhats — detect language from WhatsApp messages and inject translations into command handlers",
	"version": "1.0.0",
	"type": "module",
	"author": {
		"name": "Miguel Alexandre Uhlein",
		"email": "nedcloar1@hotmail.com"
	},
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NedcloarBR/NestWhats.git",
		"directory": "packages/locale"
	},
	"bugs": {
		"url": "https://github.com/NedcloarBR/NestWhats/issues"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"License"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"changelog": "git cliff --prepend ./CHANGELOG.md --latest -c ../../cliff.toml -r ../.. --include-path 'packages/locale/**' --tag-pattern '^locale-v'",
		"release-it": "release-it",
		"format": "biome format --write ./src",
		"lint": "biome lint ./src",
		"check": "biome check --write ./src"
	},
	"devDependencies": {
		"@nestjs/common": "12.0.1",
		"@nestjs/core": "12.0.1",
		"@types/node": "22.19.19",
		"nestwhats": "workspace:*",
		"reflect-metadata": "0.2.2",
		"release-it": "19.2.4",
		"rimraf": "6.1.3",
		"whatsapp-web.js": "^1.34.7"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.2.0 || ^11.0.0 || ^12.0.0",
		"@nestjs/core": "^10.2.0 || ^11.0.0 || ^12.0.0",
		"nestwhats": "^4.0.0",
		"whatsapp-web.js": "^1.34.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	}
}
