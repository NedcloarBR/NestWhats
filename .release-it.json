{
	"git": {
		"commitMessage": "chore: release v${version}",
		"requireBranch": "master",
		"requireCommits": true
	},
	"github": {
		"release": true,
		"releaseNotes": "git cliff --tag v${version} --unreleased --strip all -c ./cliff.toml -r ."
	},
	"npm": {
		"publish": true
	},
	"hooks": {
		"before:bump": "yarn build",
		"after:bump": "git cliff --prepend ./CHANGELOG.md --tag v${version} --unreleased -c ./cliff.toml -r . && git add CHANGELOG.md"
	}
}
