{
	"name": "nestwhats-workspace",
	"private": true,
	"version": "0.0.0",
	"packageManager": "yarn@4.6.0",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "nx run-many -t build",
		"build:core": "nx run core:build",
		"build:dashboard": "nx run dashboard:build",
		"check": "biome check --write packages/*/src",
		"format": "biome format --write packages/*/src",
		"lint": "biome lint packages/*/src",
		"release:core": "yarn workspace nestwhats release-it",
		"release:dashboard": "yarn workspace @nestwhats/dashboard release-it",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "19.8.1",
		"@commitlint/config-angular": "19.8.1",
		"@nedcloarbr/biome-config": "^1.9.2",
		"@nx/js": "22.7.3",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "15.5.2",
		"nx": "22.7.3",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=20"
	}
}
