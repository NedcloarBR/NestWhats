{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "master",
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"sharedGlobals": [
			"{workspaceRoot}/tsconfig.json",
			"{workspaceRoot}/biome.json"
		],
		"production": [
			"default",
			"!{projectRoot}/**/*.spec.ts",
			"!{projectRoot}/test/**/*"
		]
	},
	"targetDefaults": {
		"build": {
			"cache": true,
			"inputs": ["production", "^production"],
			"outputs": ["{projectRoot}/dist"],
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"cache": true,
			"inputs": ["production", "^production"],
			"dependsOn": ["^build"]
		},
		"test": {
			"cache": true,
			"inputs": ["default", "^production"]
		}
	},
	"plugins": [
		{
			"plugin": "@nx/js"
		}
	],
	"analytics": false
}
