{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"extends": [
		"@nedcloarbr/biome-config/nestjs",
		"@nedcloarbr/biome-config/ignore"
	],
	"files": {
		"include": ["packages/*/src/**", "packages/*/test/**"]
	},
	"linter": {
		"rules": {
			"style": {
				"useImportType": "off"
			},
			"complexity": {
				"noForEach": "off",
				"noBannedTypes": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
