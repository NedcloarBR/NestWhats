{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"extends": [
		"@nedcloarbr/biome-config/nestjs",
		"@nedcloarbr/biome-config/ignore"
	],
	"linter": {
		"rules": {
			"style": {
				"useImportType": "off"
			},
			"complexity": {
				"noForEach": "off",
				"noBannedTypes": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	}
}
